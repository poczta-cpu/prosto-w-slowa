---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Moments from '../components/Moments.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhyPaid from '../components/WhyPaid.astro';
import About from '../components/About.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';
import Faq from '../components/Faq.astro';
import Limits from '../components/Limits.astro';
import FinalCta from '../components/FinalCta.astro';

/*
 * Kolejność z briefu: najpierw sprzedajemy i tłumaczymy własną kategorię,
 * granice usługi stawiamy dopiero po cenniku i FAQ.
 * Tło sekcji idzie naprzemiennie (base / alt), burgund dostają dwie sekcje.
 */
---

<BaseLayout>
  <Hero />
  <Moments />
  <HowItWorks />
  <WhyPaid />
  <About />
  <Pricing />
  <Contact />
  <Faq />
  <Limits />
  <FinalCta />
</BaseLayout>

<script>
  import { initReveal } from '../scripts/reveal';
  initReveal();
</script>
