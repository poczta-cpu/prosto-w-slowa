---
import { HOW_IT_WORKS } from '../data/content';
import { CTA, bookingIsExternal } from '../data/site';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import FeatureCard from './ui/FeatureCard.astro';
import Button from './ui/Button.astro';

const externalProps = bookingIsExternal
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Section id="jak-to-dziala" labelledby="jak-to-dziala-title">
  <SectionHeading
    id="jak-to-dziala-title"
    eyebrow={HOW_IT_WORKS.eyebrow}
    title={HOW_IT_WORKS.title}
    lead={HOW_IT_WORKS.lead}
  />

  <div class="steps">
    {
      HOW_IT_WORKS.steps.map((step, index) => (
        <FeatureCard
          icon={step.icon}
          title={step.title}
          body={step.body}
          number={step.number}
          delay={index * 90}
        />
      ))
    }
  </div>

  <div class="steps__cta" data-reveal="fade" style="--reveal-delay: 380ms">
    <Button href={CTA.primary.href} variant="primary" size="lg" {...externalProps}>
      {CTA.primary.label}
    </Button>
  </div>
</Section>

<style>
  .steps {
    display: grid;
    gap: clamp(1rem, 0.85rem + 1vw, 1.75rem);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
  }

  .steps__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 1.6rem + 2vw, 3rem);
  }
</style>
