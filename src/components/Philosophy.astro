---
import { Image } from 'astro:assets';
import philosophyImage from '../assets/dlonie-dymek.png';
import { PHILOSOPHY } from '../data/content';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';

/**
 * „Nasza filozofia” — układ dwukolumnowy: grafika obok listy wartości.
 * Wartości są listą definicyjną, bo to pary nazwa → opis.
 */
---

<Section id="filozofia" labelledby="filozofia-title">
  <SectionHeading id="filozofia-title" title={PHILOSOPHY.title} subtitle={PHILOSOPHY.subtitle} />

  <div class="split split--reverse philosophy">
    <dl class="values">
      {
        PHILOSOPHY.values.map((value, index) => (
          <div class="value" data-reveal="right" style={`--reveal-delay: ${index * 130}ms`}>
            <span class="value__icon" aria-hidden="true">
              <Icon name={value.icon as never} size={20} />
            </span>
            <div class="value__text">
              <dt class="value__title">{value.title}</dt>
              <dd class="value__body">{value.body}</dd>
            </div>
          </div>
        ))
      }
    </dl>

    <div class="philosophy__media" data-reveal="left">
      <Image
        src={philosophyImage}
        alt={PHILOSOPHY.imageAlt}
        widths={[380, 560, 760]}
        sizes="(min-width: 56rem) 40vw, 88vw"
        loading="lazy"
        class="philosophy__image"
      />
    </div>
  </div>
</Section>

<style>
  .values {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
  }

  .value {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: clamp(1.1rem, 0.9rem + 0.7vw, 1.6rem);
    background-color: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .value:hover {
    transform: translateX(4px);
    border-color: var(--c-line-strong);
    background-color: var(--c-surface-raised);
  }

  .value__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    color: var(--c-accent);
    background-color: var(--c-accent-tint);
    border-radius: var(--radius-md);
  }

  .value__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .value__title {
    font-size: var(--fs-md);
    font-weight: 600;
    line-height: var(--lh-snug);
    letter-spacing: -0.01em;
  }

  .value__body {
    margin: 0;
    max-width: var(--measure);
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  .philosophy__media {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .philosophy__image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  @media (max-width: 55.999rem) {
    .philosophy__image {
      aspect-ratio: 4 / 3;
      object-position: center 35%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value:hover {
      transform: none;
    }
  }
</style>
