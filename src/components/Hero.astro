---
import { Image } from 'astro:assets';
import portret from '../assets/asia-hero.jpg';
import { HERO } from '../data/content';
import { CTA, bookingIsExternal } from '../data/site';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

/**
 * Sekcja otwierająca. W pięć sekund ma odpowiedzieć: co to jest, dla kogo
 * i co zrobić dalej — dlatego cena, czas i „kamera opcjonalna” stoją
 * bezpośrednio pod przyciskami, a nie dopiero w cenniku.
 *
 * Zdjęcie ładuje się z `loading="eager"` i wysokim priorytetem, bo jest
 * największym elementem pierwszego ekranu (liczy się do LCP).
 */

const externalProps = bookingIsExternal
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow" data-reveal="fade">{HERO.eyebrow}</p>

      <h1 class="hero__title" id="hero-title" data-reveal style="--reveal-delay: 80ms">
        {HERO.title}
      </h1>

      <p class="hero__lead" data-reveal style="--reveal-delay: 160ms">{HERO.lead}</p>

      <p class="hand hero__note" data-reveal style="--reveal-delay: 220ms">{HERO.note}</p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 280ms">
        <Button href={CTA.primary.href} variant="primary" size="lg" {...externalProps}>
          {CTA.primary.label}
        </Button>
        <Button href={CTA.secondary.href} variant="secondary" size="lg">
          {CTA.secondary.label}
        </Button>
      </div>

      <ul class="facts" data-reveal="fade" style="--reveal-delay: 360ms">
        {
          HERO.facts.map((fact) => (
            <li class="facts__item">
              <span class="facts__icon" aria-hidden="true">
                <Icon name={fact.icon as never} size={17} />
              </span>
              {fact.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__media" data-reveal="scale" style="--reveal-delay: 240ms">
      <figure class="portrait">
        <Image
          src={portret}
          alt={HERO.portraitAlt}
          widths={[420, 640, 900]}
          sizes="(min-width: 56rem) 26rem, 92vw"
          loading="eager"
          fetchpriority="high"
          class="portrait__image"
        />
        <figcaption class="hand portrait__caption">{HERO.portraitCaption}</figcaption>
      </figure>
    </div>
  </div>

  <a class="hero__scroll" href="#momenty" aria-label="Przewiń w dół">
    <Icon name="chevron" size={20} />
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-height));
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) clamp(4rem, 3rem + 5vw, 7rem);
    overflow: hidden;
  }

  /* Ciepła poświata w tle — brzoskwiniowy beż z palety, nie płaski kolor */
  .hero__glow {
    position: absolute;
    top: -25%;
    right: -14%;
    width: min(62rem, 115%);
    aspect-ratio: 1;
    background: radial-gradient(
      circle at center,
      rgb(240 215 193 / 0.9) 0%,
      rgb(250 245 238 / 0) 62%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 2rem + 4vw, 4rem);
    align-items: center;
    grid-template-columns: 1fr;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .hero__eyebrow {
    margin: 0;
    padding: 0.3rem 0.75rem;
    background-color: var(--c-accent-tint);
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-link);
  }

  .hero__title {
    margin: 0;
    max-width: 13ch;
  }

  .hero__lead {
    max-width: 40ch;
    margin: 0;
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--c-ink-muted);
  }

  .hero__note {
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  /* ── Fakty: cena, czas, kamera ──────────────────────────────────── */

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .facts__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-sm);
    color: var(--c-ink-muted);
  }

  .facts__icon {
    display: grid;
    place-items: center;
    color: var(--c-accent);
  }

  /* ── Kadr na zdjęcie ────────────────────────────────────────────── */

  .hero__media {
    position: relative;
    max-width: 26rem;
    width: 100%;
    margin-inline: auto;
  }

  .portrait {
    position: relative;
    margin: 0;
    border-radius: var(--radius-xl);
    /* Delikatne unoszenie się kadru — powolne i ledwo zauważalne */
    animation: hero-float 9s var(--ease-soft) infinite alternate;
  }

  .portrait__image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: inherit;
    box-shadow: var(--shadow-lg);
  }

  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(62 9 10 / 0.08);
    border-radius: inherit;
    pointer-events: none;
  }

  /* Odręczny dopisek jak naklejka wpięta w róg zdjęcia */
  .portrait__caption {
    position: absolute;
    z-index: 1;
    left: clamp(-0.75rem, -0.5rem - 1vw, -1.5rem);
    bottom: 1.25rem;
    padding: 0.4rem 1rem;
    background-color: var(--c-cream);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
    font-size: var(--fs-md);
    white-space: nowrap;
    rotate: -3deg;
  }

  @keyframes hero-float {
    from {
      transform: translateY(-0.4rem);
    }
    to {
      transform: translateY(0.4rem);
    }
  }

  /* ── Strzałka przewijania ───────────────────────────────────────── */

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -1.375rem;
    color: var(--c-ink-subtle);
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background-color: rgb(255 252 248 / 0.75);
    animation: hero-bob 2.4s var(--ease-soft) infinite;
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .hero__scroll:hover {
    color: var(--c-link);
    border-color: var(--c-accent-soft);
  }

  @keyframes hero-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.3rem);
    }
  }

  /* ── Breakpointy ────────────────────────────────────────────────── */

  @media (min-width: 56rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }

    .hero__media {
      margin-inline: 0 0;
    }
  }

  /* Na niskich ekranach pełna wysokość dławi treść */
  @media (max-height: 40rem) and (max-width: 56rem) {
    .hero {
      min-height: 0;
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait,
    .hero__scroll {
      animation: none;
    }
  }
</style>
