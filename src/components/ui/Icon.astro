---
/**
 * Zestaw ikon inline (SVG). Rysowane obrysem, bez wypełnień —
 * dziedziczą `currentColor`, więc kolor ustawia rodzic.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
  /** Ikony dekoracyjne (domyślnie) są ukryte przed czytnikami ekranu. */
  label?: string;
}

const PATHS = {
  clock: '<circle cx="12" cy="12" r="8.6"/><path d="M12 7.2V12l3.2 2"/>',
  calendar:
    '<rect x="3.4" y="5.2" width="17.2" height="15.4" rx="2.4"/><path d="M3.4 9.8h17.2M8.2 3.4v3.4M15.8 3.4v3.4"/>',
  video:
    '<rect x="2.8" y="6" width="12.8" height="12" rx="2.6"/><path d="m15.6 13.2 5.6 3.2V7.6l-5.6 3.2Z"/>',
  camera:
    '<rect x="2.8" y="6.6" width="18.4" height="12" rx="2.6"/><circle cx="12" cy="12.6" r="3.4"/><path d="M8.4 6.6 9.8 4h4.4l1.4 2.6"/>',
  chat: '<path d="M20.5 12.4c0 4-3.8 7.2-8.5 7.2a10 10 0 0 1-2.8-.4L4 21l1.4-3.8a6.8 6.8 0 0 1-2-4.8c0-4 3.8-7.2 8.6-7.2s8.5 3.2 8.5 7.2Z"/>',
  wallet:
    '<path d="M3.4 8.4a2.6 2.6 0 0 1 2.6-2.6h11.2a2.4 2.4 0 0 1 2.4 2.4v.4"/><rect x="3.4" y="8.4" width="17.2" height="10.6" rx="2.4"/><path d="M16.4 13.7h1.6"/>',
  balance:
    '<path d="M12 4.4v15.2M6.6 19.6h10.8"/><path d="M4 8.4h16"/><path d="m4 8.4-2 5.8a2.9 2.9 0 0 0 4 0L4 8.4Z"/><path d="m20 8.4-2 5.8a2.9 2.9 0 0 0 4 0L20 8.4Z"/>',
  people:
    '<circle cx="9" cy="8" r="3.2"/><path d="M2.8 20a6.2 6.2 0 0 1 12.4 0"/><path d="M16.2 5.2a3.2 3.2 0 0 1 0 6.1"/><path d="M17.6 14.4A6.2 6.2 0 0 1 21.2 20"/>',
  spark:
    '<path d="M12 3.2 13.7 9l5.8 1.7-5.8 1.7L12 18.2l-1.7-5.8L4.5 10.7 10.3 9 12 3.2Z"/><path d="M18.6 3.4v3M17.1 4.9h3"/>',
  check: '<path d="m4.8 12.6 4.5 4.4L19.2 7"/>',
  alert: '<circle cx="12" cy="12" r="8.8"/><path d="M12 7.6v5M12 15.9v.1"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2.2"/><path d="m3.8 7 8.2 6 8.2-6"/>',
  instagram:
    '<rect x="3.4" y="3.4" width="17.2" height="17.2" rx="5"/><circle cx="12" cy="12" r="3.9"/><path d="M17.1 6.9v.1"/>',
  quote:
    '<path d="M9.4 6.5C6.6 7.8 5 10.2 5 13.2c0 2.6 1.5 4.3 3.6 4.3 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.5-2.7 3.1-3.5l-.8-1.3Z"/><path d="M18 6.5c-2.8 1.3-4.4 3.7-4.4 6.7 0 2.6 1.5 4.3 3.6 4.3 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.5-2.7 3.1-3.5L18 6.5Z"/>',
  arrow: '<path d="M4.5 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  chevron: '<path d="m7 10 5 5 5-5"/>',
} as const;

const { name, size = 24, class: className, label } = Astro.props;
const path = PATHS[name];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={path}
/>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
