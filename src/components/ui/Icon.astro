---
/**
 * Zestaw ikon inline (SVG). Rysowane obrysem, bez wypełnień —
 * dziedziczą `currentColor`, więc kolor ustawia rodzic.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
  /** Ikony dekoracyjne (domyślnie) są ukryte przed czytnikami ekranu. */
  label?: string;
}

const PATHS = {
  heart:
    '<path d="M12 20.5S3.5 15.2 3.5 9.4A4.9 4.9 0 0 1 12 6a4.9 4.9 0 0 1 8.5 3.4c0 5.8-8.5 11.1-8.5 11.1Z"/>',
  leaf: '<path d="M4 20c0-8 5-14 16-14 0 9-5 14-12 14H4Z"/><path d="M8.5 15.5C11 13 14 11.5 17 10.8"/>',
  people:
    '<circle cx="9" cy="8" r="3.2"/><path d="M2.8 20a6.2 6.2 0 0 1 12.4 0"/><path d="M16.2 5.2a3.2 3.2 0 0 1 0 6.1"/><path d="M17.6 14.4A6.2 6.2 0 0 1 21.2 20"/>',
  phone:
    '<path d="M6.3 3.5h3l1.6 4-2 1.4a11.5 11.5 0 0 0 5.2 5.2l1.4-2 4 1.6v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.3 5.7a2 2 0 0 1 2-2.2Z"/>',
  chat: '<path d="M20.5 12.4c0 4-3.8 7.2-8.5 7.2a10 10 0 0 1-2.8-.4L4 21l1.4-3.8a6.8 6.8 0 0 1-2-4.8c0-4 3.8-7.2 8.6-7.2s8.5 3.2 8.5 7.2Z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.6v2.1M12 19.3v2.1M21.4 12h-2.1M4.7 12H2.6M18.6 5.4l-1.5 1.5M6.9 17.1l-1.5 1.5M18.6 18.6l-1.5-1.5M6.9 6.9 5.4 5.4"/>',
  shield: '<path d="M12 3.2 4.8 6v5.6c0 4.3 3 8.2 7.2 9.4 4.2-1.2 7.2-5.1 7.2-9.4V6L12 3.2Z"/>',
  balance:
    '<path d="M12 4v16M6 20h12"/><path d="M4 8h16"/><path d="M4 8 2 14a3 3 0 0 0 4 0L4 8Z"/><path d="M20 8l-2 6a3 3 0 0 0 4 0l-2-6Z"/>',
  location: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2.2"/><path d="m3.8 7 8.2 6 8.2-6"/>',
  clock: '<circle cx="12" cy="12" r="8.6"/><path d="M12 7.2V12l3.2 2"/>',
  document:
    '<path d="M13.5 3.2H7a2 2 0 0 0-2 2v13.6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.7l-5.5-5.5Z"/><path d="M13.4 3.4v5.2h5.3"/><path d="M8.8 13.4h6.4M8.8 16.8h4.4"/>',
  arrow: '<path d="M4.5 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  quote:
    '<path d="M9.4 6.5C6.6 7.8 5 10.2 5 13.2c0 2.6 1.5 4.3 3.6 4.3 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.5-2.7 3.1-3.5l-.8-1.3Z"/><path d="M18 6.5c-2.8 1.3-4.4 3.7-4.4 6.7 0 2.6 1.5 4.3 3.6 4.3 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.5-2.7 3.1-3.5L18 6.5Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  chevron: '<path d="m7 10 5 5 5-5"/>',
} as const;

const { name, size = 24, class: className, label } = Astro.props;
const path = PATHS[name];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={path}
/>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
