---
/**
 * Nagłówek sekcji: krótka etykieta, tytuł redakcyjny (Cormorant Garamond)
 * i opcjonalny wprowadzający akapit.
 *
 * Domyślnie wyrównany do lewej — układ ma być redakcyjny, nie „landingowy”.
 */
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  /** Poziom nagłówka — domyślnie h2, bo H1 należy do sekcji hero. */
  as?: 'h2' | 'h3';
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  lead,
  align = 'start',
  as: Tag = 'h2',
  class: className,
} = Astro.props;
---

<div class:list={['heading', `heading--${align}`, className]} data-reveal>
  {
    eyebrow && (
      <p class="heading__eyebrow">
        <span class="heading__dash" aria-hidden="true" />
        {eyebrow}
      </p>
    )
  }
  <Tag id={id} class="heading__title">{title}</Tag>
  {lead && <p class="heading__lead">{lead}</p>}
</div>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--section-gap);
  }

  .heading--center {
    align-items: center;
    text-align: center;
  }

  .heading--start {
    align-items: flex-start;
    text-align: left;
  }

  .heading__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--c-ink-subtle);
  }

  .heading__dash {
    display: block;
    width: 1.75rem;
    height: 2px;
    border-radius: 2px;
    background-color: var(--c-accent);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-soft) 200ms;
  }

  .heading.is-revealed .heading__dash {
    transform: scaleX(1);
  }

  .heading__title {
    max-width: 20ch;
    margin: 0;
  }

  .heading__lead {
    max-width: var(--measure);
    margin: var(--space-3xs) 0 0;
    color: var(--c-ink-muted);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
  }

  /* Sekcja na burgundowym tle */
  :global(.section--ink) .heading__eyebrow {
    color: var(--c-on-ink-muted);
  }

  :global(.section--ink) .heading__dash {
    background-color: var(--c-on-ink-accent);
  }

  :global(.section--ink) .heading__lead {
    color: var(--c-on-ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .heading__dash {
      transform: scaleX(1);
      transition: none;
    }
  }
</style>
