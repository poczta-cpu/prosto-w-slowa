---
import { FINAL_CTA } from '../data/content';
import { CTA, bookingIsExternal } from '../data/site';
import Section from './ui/Section.astro';
import Button from './ui/Button.astro';

/**
 * Zamknięcie strony: jedno zdanie, jeden przycisk. Nagłówek w Archivo Black —
 * to jedno z dwóch miejsc na stronie, gdzie ten krój dostaje głos.
 */

const externalProps = bookingIsExternal
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Section id="przegadajmy" tone="ink" labelledby="final-cta-title" class="cta">
  <span class="cta__halo" aria-hidden="true"></span>

  <div class="cta__inner">
    <h2 class="display cta__title" id="final-cta-title" data-reveal>{FINAL_CTA.title}</h2>

    <p class="cta__body" data-reveal style="--reveal-delay: 100ms">{FINAL_CTA.body}</p>

    <div class="cta__actions" data-reveal="fade" style="--reveal-delay: 200ms">
      <Button href={CTA.primary.href} variant="inverse" size="lg" {...externalProps}>
        {CTA.primary.label}
      </Button>
      <Button href={CTA.pricing.href} variant="inverse-outline" size="lg">
        {CTA.pricing.label}
      </Button>
    </div>

    <p class="hand cta__note" data-reveal="fade" style="--reveal-delay: 300ms">
      {FINAL_CTA.note}
    </p>
  </div>
</Section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .cta__halo {
    position: absolute;
    top: -45%;
    left: 50%;
    width: min(60rem, 130%);
    aspect-ratio: 1;
    translate: -50% 0;
    background: radial-gradient(circle at center, rgb(138 26 45 / 0.4) 0%, transparent 62%);
    pointer-events: none;
  }

  .cta :global(.container) {
    position: relative;
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .cta__title {
    max-width: 16ch;
    margin: 0;
    color: var(--c-on-ink);
  }

  .cta__body {
    max-width: var(--measure-narrow);
    margin: 0;
    color: var(--c-on-ink-muted);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .cta__note {
    margin: var(--space-2xs) 0 0;
    color: var(--c-peach);
  }
</style>
