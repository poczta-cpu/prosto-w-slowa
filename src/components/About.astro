---
import { Image } from 'astro:assets';
import portret from '../assets/asia-o-mnie.jpg';
import { ABOUT } from '../data/content';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';

/**
 * „O mnie” — krótko i osobiście, bez budowania autorytetu, którego
 * usługa nie ma. Zdjęcie z bliska, cytat pod spodem zamiast podpisu.
 */
---

<Section id="o-mnie" labelledby="o-mnie-title">
  <div class="about">
    <div class="about__text">
      <SectionHeading id="o-mnie-title" eyebrow={ABOUT.eyebrow} title={ABOUT.title} />

      {
        ABOUT.paragraphs.map((paragraph, index) => (
          <p class="about__paragraph" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            {paragraph}
          </p>
        ))
      }

      <p class="hand about__note" data-reveal="fade" style="--reveal-delay: 320ms">
        {ABOUT.note}
      </p>
    </div>

    <div class="about__media" data-reveal="left" style="--reveal-delay: 140ms">
      <figure class="frame">
        <Image
          src={portret}
          alt={ABOUT.imageAlt}
          widths={[360, 560, 760]}
          sizes="(min-width: 56rem) 24rem, 92vw"
          loading="lazy"
          class="frame__image"
        />
        <figcaption class="frame__quote">{ABOUT.quote}</figcaption>
      </figure>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    align-items: start;
    grid-template-columns: 1fr;
  }

  .about__text :global(.heading) {
    margin-bottom: var(--space-md);
  }

  .about__paragraph {
    max-width: var(--measure);
    margin: 0 0 var(--space-sm);
    color: var(--c-ink-muted);
    line-height: var(--lh-relaxed);
  }

  .about__note {
    margin: var(--space-sm) 0 0;
  }

  /* ── Zdjęcie i cytat ────────────────────────────────────────────── */

  .frame {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 24rem;
    margin: 0 auto;
  }

  .frame__image {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .frame__quote {
    margin: 0;
    padding-left: var(--space-sm);
    border-left: 3px solid var(--c-accent-soft);
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--c-burgundy);
    text-wrap: balance;
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .frame {
      margin-inline: 0 0;
    }
  }
</style>
