---
import { RULES } from '../data/content';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';

/**
 * „Regulamin” — trzy numerowane zasady oraz odnośnik do pełnego dokumentu.
 */
---

<Section id="regulamin" tone="alt" labelledby="regulamin-title">
  <SectionHeading id="regulamin-title" title={RULES.title} subtitle={RULES.subtitle} />

  <ol class="rules">
    {
      RULES.items.map((item, index) => (
        <li class="rule" data-reveal style={`--reveal-delay: ${index * 110}ms`}>
          <span class="rule__number" aria-hidden="true">
            {item.number}
          </span>
          <div class="rule__text">
            <h3 class="rule__title">{item.title}</h3>
            <p class="rule__body">{item.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <a class="rules__link" href={RULES.link.href} data-reveal="fade" style="--reveal-delay: 340ms">
    <span class="rules__link-icon" aria-hidden="true"><Icon name="document" size={20} /></span>
    <span class="rules__link-text">
      <strong>{RULES.link.label}</strong>
      <span>{RULES.link.note}</span>
    </span>
    <span class="rules__link-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
  </a>
</Section>

<style>
  .rules {
    display: grid;
    gap: clamp(1rem, 0.8rem + 1vw, 1.75rem);
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rule;
  }

  .rule {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    background-color: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .rule:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .rule__number {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: 1;
    color: var(--c-on-ink);
    background-color: var(--c-ink);
    border-radius: 50%;
    font-variation-settings: 'SOFT' 40, 'opsz' 24;
  }

  .rule__text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .rule__title {
    margin: 0;
    font-size: var(--fs-md);
  }

  .rule__body {
    margin: 0;
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  /* ── Odnośnik do pełnego regulaminu ─────────────────────────────── */

  .rules__link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: fit-content;
    max-width: 100%;
    margin-top: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    margin-inline: auto;
    padding: var(--space-sm) var(--space-md);
    background-color: transparent;
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .rules__link:hover {
    color: var(--c-ink);
    border-color: var(--c-accent);
    border-style: solid;
    background-color: var(--c-accent-tint);
  }

  .rules__link-icon {
    display: grid;
    place-items: center;
    color: var(--c-accent);
    flex-shrink: 0;
  }

  .rules__link-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .rules__link-text span {
    color: var(--c-ink-muted);
    font-size: var(--fs-xs);
  }

  .rules__link-arrow {
    display: grid;
    place-items: center;
    color: var(--c-ink-subtle);
    flex-shrink: 0;
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .rules__link:hover .rules__link-arrow {
    transform: translateX(4px);
    color: var(--c-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .rule:hover,
    .rules__link:hover .rules__link-arrow {
      transform: none;
    }
  }
</style>
