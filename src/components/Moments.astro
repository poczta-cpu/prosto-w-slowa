---
import { MOMENTS } from '../data/content';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';

/**
 * „Może znasz ten moment” — zdania, które ludzie mówią sami do siebie,
 * zanim w ogóle pomyślą o umówieniu rozmowy. Konkretne sceny zamiast
 * abstrakcyjnych deklaracji, zgodnie z tone of voice marki.
 */
---

<Section id="momenty" tone="alt" labelledby="momenty-title">
  <SectionHeading
    id="momenty-title"
    eyebrow={MOMENTS.eyebrow}
    title={MOMENTS.title}
    lead={MOMENTS.lead}
  />

  <ul class="moments">
    {
      MOMENTS.items.map((item, index) => (
        <li class="moment" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <p class="moment__quote">„{item.quote}”</p>
          <p class="moment__body">{item.body}</p>
        </li>
      ))
    }
  </ul>

  <div class="scenes" data-reveal="fade">
    <p class="scenes__intro">Z czym ludzie przychodzą:</p>
    <ul class="scenes__list">
      {MOMENTS.scenes.map((scene) => <li class="scenes__item">{scene}</li>)}
    </ul>
    <p class="hand scenes__note">{MOMENTS.note}</p>
  </div>
</Section>

<style>
  .moments {
    display: grid;
    gap: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moment {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    padding: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    background-color: var(--c-surface);
    border: 1px solid var(--c-line);
    border-left: 3px solid var(--c-accent-soft);
    border-radius: var(--radius-md);
    transition:
      border-left-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .moment:hover {
    border-left-color: var(--c-accent);
    transform: translateX(3px);
  }

  .moment__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    font-weight: 500;
    font-style: italic;
    line-height: 1.25;
    color: var(--c-ink);
    text-wrap: balance;
  }

  .moment__body {
    margin: 0;
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  /* ── Konkretne sceny ────────────────────────────────────────────── */

  .scenes {
    margin-top: clamp(2rem, 1.6rem + 2vw, 3.25rem);
    padding: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem);
    background-color: var(--c-peach-soft);
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--radius-lg);
  }

  .scenes__intro {
    margin: 0 0 var(--space-sm);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-ink-subtle);
  }

  .scenes__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scenes__item {
    padding: 0.4rem 0.9rem;
    background-color: var(--c-surface-raised);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--c-ink-muted);
  }

  .scenes__note {
    margin: var(--space-md) 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .moment:hover {
      transform: none;
    }
  }
</style>
