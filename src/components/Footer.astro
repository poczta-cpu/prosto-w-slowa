---
import { SITE, NAV_LINKS, CONTACT, LEGAL } from '../data/site';
import Icon from './ui/Icon.astro';

const year = new Date().getFullYear();

const LEGAL_LINKS = [
  { label: 'Regulamin', href: LEGAL.termsHref },
  { label: 'Polityka prywatności', href: LEGAL.privacyHref },
].filter((link) => link.href);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href="#top">
        <span class="footer__mark" aria-hidden="true"></span>
        {SITE.name}
      </a>
      <p class="footer__tagline">Płatne rozmowy 1:1 online. Bez oceniania, bez naprawiania.</p>
    </div>

    <nav class="footer__nav" aria-label="Nawigacja w stopce">
      <ul class="footer__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li><a href="#granice">Granice usługi</a></li>
        <li><a href="#umow">Umów rozmowę</a></li>
      </ul>
    </nav>

    <div class="footer__contact">
      <a
        class="footer__channel"
        href={CONTACT.instagramHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="instagram" size={17} />
        {CONTACT.instagram}
      </a>
      {
        CONTACT.email && (
          <a class="footer__channel" href={`mailto:${CONTACT.email}`}>
            <Icon name="mail" size={17} />
            {CONTACT.email}
          </a>
        )
      }
    </div>
  </div>

  <div class="container footer__bar">
    <p class="footer__copy">© {year} {SITE.name}</p>
    {
      LEGAL_LINKS.length > 0 && (
        <ul class="footer__legal">
          {LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4rem) var(--space-lg);
    background-color: var(--c-bg-alt);
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-sm);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
    padding-bottom: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .footer__inner {
      grid-template-columns: 1.2fr 1fr auto;
      align-items: start;
    }
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 400;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .footer__mark {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background-color: var(--c-accent);
  }

  .footer__tagline {
    max-width: 32ch;
    margin: var(--space-2xs) 0 0;
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
  }

  .footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__list a {
    color: var(--c-ink-muted);
    text-decoration: none;
  }

  .footer__list a:hover {
    color: var(--c-link);
    text-decoration: underline;
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .footer__channel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-ink-muted);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__channel:hover {
    color: var(--c-link);
    text-decoration: underline;
  }

  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--c-line);
    color: var(--c-ink-subtle);
    font-size: var(--fs-xs);
  }

  .footer__copy {
    margin: 0;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__legal a {
    color: var(--c-ink-subtle);
    text-decoration: none;
  }

  .footer__legal a:hover {
    color: var(--c-link);
    text-decoration: underline;
  }
</style>
