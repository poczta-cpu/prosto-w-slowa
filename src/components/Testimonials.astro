---
import { TESTIMONIALS } from '../data/content';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';

/**
 * Opinie klientów. Każda karta to <blockquote> z oceną w gwiazdkach —
 * ocena jest też podana tekstowo dla czytników ekranu.
 */
---

<Section id="opinie" tone="alt" labelledby="opinie-title">
  <SectionHeading id="opinie-title" title={TESTIMONIALS.title} subtitle={TESTIMONIALS.subtitle} />

  <ul class="grid-cards testimonials">
    {
      TESTIMONIALS.items.map((item, index) => (
        <li class="testimonials__item" data-reveal style={`--reveal-delay: ${index * 110}ms`}>
          <figure class="testimonial">
            <span class="testimonial__mark" aria-hidden="true">
              <Icon name="quote" size={26} />
            </span>

            <div class="testimonial__stars">
              <span class="visually-hidden">Ocena: {item.rating} na 5</span>
              {Array.from({ length: item.rating }).map(() => (
                <svg
                  class="testimonial__star"
                  viewBox="0 0 24 24"
                  width="15"
                  height="15"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    fill="currentColor"
                    d="m12 3.3 2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.5l5.9-.8L12 3.3Z"
                  />
                </svg>
              ))}
            </div>

            <blockquote class="testimonial__quote">
              <p>{item.quote}</p>
            </blockquote>

            <figcaption class="testimonial__author">{item.author}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .testimonials {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .testimonials__item {
    display: flex;
  }

  .testimonial {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
    margin: 0;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background-color: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .testimonial:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .testimonial__mark {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    color: var(--c-accent-soft);
    transition:
      transform var(--dur-slow) var(--ease-soft),
      color var(--dur-base) var(--ease-out);
  }

  .testimonial:hover .testimonial__mark {
    transform: translateY(-2px) scale(1.08);
    color: var(--c-accent-tint);
  }

  .testimonial__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--c-accent);
  }

  .testimonial__quote {
    flex: 1;
    margin: 0;
    color: var(--c-ink);
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
  }

  .testimonial__quote p {
    margin: 0;
  }

  /* Cudzysłowy drukarskie dodane przez CSS — treść w danych zostaje czysta */
  .testimonial__quote p::before {
    content: '„';
  }

  .testimonial__quote p::after {
    content: '”';
  }

  .testimonial__author {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink-muted);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial:hover,
    .testimonial:hover .testimonial__mark {
      transform: none;
    }
  }
</style>
