---
import { BOOKING_SECTION } from '../data/content';
import { CONTACT, BOOKING } from '../data/site';
import Section from './ui/Section.astro';
import SectionHeading from './ui/SectionHeading.astro';
import ContactForm from './ContactForm.astro';
import Icon from './ui/Icon.astro';

/**
 * „Umów rozmowę” — docelowo miejsce na system rezerwacji. Dopóki
 * `BOOKING.href` w `src/data/site.ts` jest pusty, wszystkie CTA prowadzą
 * tutaj, a formularz jest realną ścieżką umówienia terminu.
 */

const CHANNELS = [
  {
    icon: 'instagram',
    label: 'Instagram',
    value: CONTACT.instagram,
    href: CONTACT.instagramHref,
    external: true,
  },
  {
    icon: 'mail',
    label: 'E-mail',
    value: CONTACT.email,
    href: CONTACT.email ? `mailto:${CONTACT.email}` : '',
    external: false,
  },
].filter((channel) => channel.value);
---

<Section id="umow" labelledby="umow-title">
  <SectionHeading
    id="umow-title"
    eyebrow={BOOKING_SECTION.eyebrow}
    title={BOOKING_SECTION.title}
    lead={BOOKING_SECTION.lead}
  />

  <div class="booking">
    <div class="booking__form" data-reveal>
      <ContactForm />
    </div>

    <aside class="booking__aside" data-reveal="left" style="--reveal-delay: 120ms">
      <div class="panel">
        <h3 class="panel__title">Co się dzieje dalej</h3>
        <ol class="panel__list">
          <li>Odpowiadam i proponuję terminy.</li>
          <li>Wybierasz godzinę i długość rozmowy.</li>
          <li>Dostajesz link — łączymy się o umówionej porze.</li>
        </ol>
      </div>

      {
        CHANNELS.length > 0 && (
          <div class="panel">
            <h3 class="panel__title">Wolisz napisać gdzie indziej?</h3>
            <ul class="channels">
              {CHANNELS.map((channel) => (
                <li class="channel">
                  <span class="channel__icon" aria-hidden="true">
                    <Icon name={channel.icon as never} size={18} />
                  </span>
                  <a
                    class="channel__link"
                    href={channel.href}
                    target={channel.external ? '_blank' : undefined}
                    rel={channel.external ? 'noopener noreferrer' : undefined}
                  >
                    {channel.value}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        !BOOKING.href && (
          <p class="booking__hint">
            Rezerwacja online jeszcze się dopina — na razie termin ustalamy wiadomością.
          </p>
        )
      }
    </aside>
  </div>
</Section>

<style>
  .booking {
    display: grid;
    gap: clamp(1.5rem, 1.2rem + 2.4vw, 3rem);
    align-items: start;
    grid-template-columns: 1fr;
  }

  .booking__form {
    padding: clamp(1.5rem, 1.2rem + 1.6vw, 2.5rem);
    background-color: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .booking__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .panel {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background-color: var(--c-peach-soft);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
  }

  .panel__title {
    margin: 0 0 var(--space-2xs);
    font-size: var(--fs-md);
  }

  .panel__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding-left: 1.15rem;
    color: var(--c-ink-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  .panel__list::marker {
    color: var(--c-accent);
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channel {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--fs-sm);
  }

  .channel__icon {
    display: grid;
    place-items: center;
    color: var(--c-accent);
  }

  .channel__link {
    color: var(--c-link);
    overflow-wrap: anywhere;
  }

  .booking__hint {
    margin: 0;
    color: var(--c-ink-subtle);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
  }

  @media (min-width: 56rem) {
    .booking {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    }
  }
</style>
